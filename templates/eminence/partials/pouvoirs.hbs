{{!log "EminenceSheet - Partials - Pouvoirs" this }}
<div class="eminence-pouvoirs{{#if isStyleJeuAvance}} avance{{/if}}">
    <span class="titre-section-pouvoirs">{{localize "PENOMBRE.ui.pouvoirs"}}</span>
    {{!-- Création d'un objet : à droite du titre et de sa volute --}}
    {{#if unlocked}}<a class="plusitem plusitem-titre item-control" data-tooltip="{{ localize 'PENOMBRE.ui.create' item='un pouvoir' }}" data-action="create" data-type="pouvoir"><i class="fas fa-plus"></i></a>{{/if}}
    <div class="content">
        {{> "systems/penombre/templates/eminence/partials/_potentiel.hbs" potentielType="pouvoirs"}}
        <div class="pouvoirs{{#if isStyleJeuAvance}} avance{{/if}} absolue">
            {{!-- Liste sur deux colonnes (remplies de haut en bas) : case, nom (prend toute la place restante), type, boutons --}}
            <div class="liste-pouvoirs">
                {{#each pouvoirs as |item id|}}
                <div class="ligne-pouvoir item draggable" data-item-id="{{item._id}}">
                    <span class="item-coche">
                        <img class="item-case" data-action="utilisePouvoir" data-item-id="{{item._id}}" data-tooltip="{{#if item.system.utilise}}{{localize 'PENOMBRE.ui.utilise'}}{{else}}{{localize 'PENOMBRE.ui.nonUtilise'}}{{/if}}" src="systems/penombre/assets/ui/transp_case_{{#if item.system.utilise}}checked{{else}}unchecked{{/if}}.webp"/>
                    </span>
                    <span class="item-name" data-tooltip-html="{{item.enrichedTooltip}}" data-tooltip-class="pouvoir-tooltip" data-tooltip-direction="LEFT">{{item.name}}</span>
                    <span class="item-type">{{ localize (concat 'PENOMBRE.Pouvoir.type.' item.system.type '.label') }}</span>
                    {{#if ../unlocked}}
                    <span class="item-controls">
                        <a class="item-control" data-tooltip="{{ localize 'PENOMBRE.ui.edit' }}" data-action="edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-tooltip="{{ localize 'PENOMBRE.ui.delete' }}" data-action="delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
                    </span>
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>