{{!log "EminenceSheet - Partials - Pouvoirs" this }}
<div class="eminence-pouvoirs{{#if isStyleJeuAvance}} avance{{/if}}">
    <span class="titre-section-pouvoirs">{{localize "PENOMBRE.ui.pouvoirs"}}</span>
    <div class="content">
        {{> "systems/penombre/templates/eminence/partials/_potentiel.hbs" potentielType="pouvoirs"}}
        <div class="pouvoirs{{#if isStyleJeuAvance}} avance{{/if}} absolue">
            <table class="item-list centpourcent">
                <tr class="centpourcent">
                    <th class="item-coche">
                        {{localize "PENOMBRE.ui.utilise"}}
                    </th>
                    <th>
                        {{ localize 'PENOMBRE.ui.nom' }}
                    </th>
                    <th>
                        {{ localize 'PENOMBRE.ui.type' }}
                    </th>
                    <th class="item-controls">
                        {{#if unlocked}}
                            <a class="plusitem item-control" data-tooltip="{{ localize 'PENOMBRE.ui.create' item='un pouvoir' }}" data-action="create" data-type="pouvoir"><i class="fas fa-plus"></i></a>
                        {{/if}}
                    </th>
                </tr>
                {{#each pouvoirs as |item id|}}
                <tr class="item draggable" data-item-id="{{item._id}}">
                    <td class="item-coche">
                        <img class="item-case" data-action="utilisePouvoir" data-item-id="{{item._id}}" src="systems/penombre/assets/ui/transp_case_{{#if item.system.utilise}}checked{{else}}unchecked{{/if}}.webp"/>
                    </td>
                    <td>
                        <span class="item-name" data-tooltip="{{item.enrichedTooltip}}" data-tooltip-class="pouvoir-tooltip" data-tooltip-direction="RIGHT">{{item.name}}</span>
                    </td>
                    <td>
                        <span class="item-type">{{ localize (concat 'PENOMBRE.Pouvoir.type.' item.system.type '.label') }}</span>
                    </td>
                    <td class="item-controls">
                    {{#if ../unlocked}}
                        <a class="item-control" data-tooltip="{{ localize 'PENOMBRE.ui.edit' }}" data-action="edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-tooltip="{{ localize 'PENOMBRE.ui.delete' }}" data-action="delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
                    {{/if}}
                    </td>
                </tr>
                {{/each}}
            </table>
        </div>
    </div>
</div>