{{!log "EminenceSheet - Partials - Atouts" this }}
<div class="eminence-atouts{{#if isStyleJeuAvance}} avance{{/if}}">
    <span class="titre-section-atouts">{{localize "PENOMBRE.ui.atouts"}}</span>
    {{!-- Création d'un objet : à droite du titre et de sa volute --}}
    {{#if unlocked}}<a class="plusitem plusitem-titre item-control" data-tooltip="{{ localize 'PENOMBRE.ui.create' item='un atout' }}" data-action="create" data-type="atout"><i class="fas fa-plus"></i></a>{{/if}}
    <div class="content">
        {{> "systems/penombre/templates/eminence/partials/_potentiel.hbs" potentielType="atouts"}}
        <div class="atouts{{#if isStyleJeuAvance}} avance{{/if}} absolue">
            <table class="item-list centpourcent">
                {{#each atouts as |item id|}}
                <tr class="item draggable" data-item-id="{{item._id}}">
                    <td>
                        <span class="item-name" data-tooltip="{{{item.system.description}}}">{{item.name}}</span>
                    </td>
                    <td class="item-case-width" data-tooltip="{{localize 'PENOMBRE.ui.valeurTooltip' valeur=item.system.valeur}}">
                        <span class="cases-atout">
                        {{#times 3}}
                            <img class="item-case" src="systems/penombre/assets/ui/de_case_{{#if (gte item.system.valeur @index)}}checked{{else}}unchecked{{/if}}.webp"/>
                        {{/times}}
                        </span>
                    </td>
                    {{!-- Colonne des boutons seulement en mode édition : en lecture, les cubes finissent la ligne --}}
                    {{#if ../unlocked}}
                    <td class="item-controls">
                        <a class="item-control" data-tooltip="{{ localize 'PENOMBRE.ui.edit' }}" data-action="edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
                        <a class="item-control" data-tooltip="{{ localize 'PENOMBRE.ui.delete' }}" data-action="delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
                    </td>
                    {{/if}}
                </tr>
                {{/each}}
            </table>
        </div>

    </div>
</div>