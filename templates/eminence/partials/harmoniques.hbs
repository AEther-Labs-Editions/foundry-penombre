{{!log "harmoniques" this}}
<div class="eminence-harmoniques flexible">
  <div class="col-1-1 text-vertical-harmoniques">{{localize "PENOMBRE.ui.section.harmoniques"}}</div>
  <div class="col-2-1 frise-verticale"></div>
  <div class="col-3-1 flexible">
    {{!-- Une seule boucle : la position de chaque dé (x, y) vient de SYSTEM.HARMONIQUES_FICHE. Des div et non figure/figcaption : Foundry leur applique un style d'article (marges, cadre, italique) --}}
    <div class="harmoniques-grille">
      {{#each harmoniques as |h|}}
      <div class="harmonique" data-harmonique="{{h.id}}" data-tooltip="{{h.tooltip}}" style="--x: {{h.x}}px; --y: {{h.y}}px;">
        <div class="harmonique-de">
          <img class="harmonique-case" src="systems/penombre/assets/ui/case_de_penombre.webp" alt="" />
          {{#if @root.unlocked}}
          <select name="{{h.name}}" class="harmonique-saisie">
            {{selectOptions @root.harmoniqueValueChoices selected=h.valeur localize=true}}
          </select>
          {{else}}
          <img class="harmonique-image click draggable jetHarmonique" src="{{getDiceImage h.valeur}}" alt="{{h.label}}" data-action="jetHarmonique" data-harmonique="{{h.id}}" />
          {{/if}}
        </div>
        <div class="harmonique-nom">{{h.label}}</div>
      </div>
      {{/each}}
    </div>
  </div>
</div>
