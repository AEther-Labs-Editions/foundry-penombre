{{!log "conscience" this}}
<div class="eminence-conscience eminence-conscience-{{#if locked}}locked{{else}}unlocked{{/if}} flexible">
  <div class="col-1-1 text-vertical-conscience">{{localize "PENOMBRE.ui.section.conscience"}}</div>
  <div class="col-2-1 frise-verticale"></div>
  <div class="col-3-1 flexible">
    <div class="col-1-3">

      <!-- Conscience -->
      {{#if unlocked}}       
          {{formGroup systemFields.conscience.fields.max value=systemSource.conscience.max localize=true}}
      {{else}}
          {{!-- Chaque valeur dans un rond doré, libellé à droite, comme le cercle « Max » de la fiche du livre --}}
          <div class="ligne-conscience">
            <div class="rond-conscience"><span class="rond-valeur">{{nbJetonsRestantsConscience}}</span><label>{{localize "PENOMBRE.ui.conscienceDispo"}}</label></div>
            <div class="rond-conscience"><span class="rond-valeur">{{system.conscience.valeur}}</span><label>{{localize "PENOMBRE.ui.conscienceVal"}}</label></div>
            <div class="rond-conscience"><span class="rond-valeur">{{system.conscience.max}}</span><label>{{localize "PENOMBRE.ui.conscienceMax"}}</label></div>
          </div>
      {{/if}}

      <!-- Jetons-->
      <div class="div-jetons" data-tooltip="{{localize 'PENOMBRE.ui.clicJetons'}}">
          {{#each jetons as |jeton id|}}
            {{#if (or (eq jeton.statut 'actif') (eq jeton.statut 'inactif'))}}
              <img class="jeton jeton-contextmenu dropshadow-{{jeton.statut}}" data-action="jeton" data-index="{{@index}}" src="{{getJetonImage jeton.statut}}"/>
            {{else}}
              <img class="jeton jeton-contextmenu" data-index="{{@index}}" src="systems/penombre/assets/ui/cercle.webp"/>
            {{/if}}
          {{/each}}
      </div>

      <!-- Complications -->
      <div class="titre-complications">{{localize "PENOMBRE.ui.complicationsListe"}}</div>
      {{#if unlocked}}                            
          <div class="cadre-complications-2">

              <div class="form-group div-cases">
                <div class="form-fields div-descriptions">
                  {{formInput systemFields.conscience.fields.complications.fields.une.fields.description value=systemSource.conscience.complications.une.description localize=true class="div-description-2"}}
                </div>
                <div class="images-cases" data-tooltip="{{system.conscience.complications.une.valeur}}">
                  {{#times 3}}
                    <img class="complication-case" data-action="complication" data-complication="une" data-index="{{@index}}" src="systems/penombre/assets/ui/transp_case_{{#if (gte systemSource.conscience.complications.une.valeur @index)}}checked{{else}}unchecked{{/if}}.webp"/>
                  {{/times}}
                </div>
              </div>

              <div class="form-group div-cases">
                <div class="form-fields div-descriptions">
                  {{formInput systemFields.conscience.fields.complications.fields.deux.fields.description value=systemSource.conscience.complications.deux.description localize=true class="div-description-2"}}
                </div>
                <div class="images-cases" data-tooltip="{{system.conscience.complications.deux.valeur}}">
                  {{#times 3}}
                    <img class="complication-case" data-action="complication" data-complication="deux" data-index="{{@index}}" src="systems/penombre/assets/ui/transp_case_{{#if (gte systemSource.conscience.complications.deux.valeur @index)}}checked{{else}}unchecked{{/if}}.webp"/>
                  {{/times}}
                </div>
              </div>

              <div class="form-group div-cases">
                <div class="form-fields div-descriptions">
                  {{formInput systemFields.conscience.fields.complications.fields.trois.fields.description value=systemSource.conscience.complications.trois.description localize=true class="div-description-2"}}
                </div>
                <div class="images-cases" data-tooltip="{{system.conscience.complications.trois.valeur}}">
                  {{#times 3}}
                    <img class="complication-case" data-action="complication" data-complication="trois" data-index="{{@index}}" src="systems/penombre/assets/ui/transp_case_{{#if (gte systemSource.conscience.complications.trois.valeur @index)}}checked{{else}}unchecked{{/if}}.webp"/>
                  {{/times}}
                </div>
              </div>

              <div class="form-group div-cases">
                <div class="form-fields div-descriptions">
                  {{formInput systemFields.conscience.fields.complications.fields.quatre.fields.description value=systemSource.conscience.complications.quatre.description localize=true class="div-description-2"}}
                </div>
                <div class="images-cases" data-tooltip="{{system.conscience.complications.quatre.valeur}}">
                  {{#times 3}}
                    <img class="complication-case" data-action="complication" data-complication="quatre" data-index="{{@index}}" src="systems/penombre/assets/ui/transp_case_{{#if (gte systemSource.conscience.complications.quatre.valeur @index)}}checked{{else}}unchecked{{/if}}.webp"/>
                  {{/times}}
                </div>
              </div>

          </div>
      {{else}}
        <div class="cadre-complications">
          {{#each system.conscience.complications as |complication id|}}
            <div class="ligne-complication">
              <div class="form-group div-descriptions">
                <div class="form-fields">{{complication.description}}</div>
              </div>
              <div class="form-group div-cases" data-tooltip="{{complication.valeur}}">
                <div class="images-cases">
                  <!-- id : une, deux, trois, quatre ; @index : 1, 2, 3 -->
                  {{#times 3}}
                    <img class="complication-case" src="systems/penombre/assets/ui/transp_case_{{#if (gte complication.valeur @index)}}checked{{else}}unchecked{{/if}}.webp"/>
                  {{/times}}
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      {{/if}}
      <div class="note-jetons">
        <span>{{localize "PENOMBRE.ui.creerJetons"}}</span>
      </div>
    </div>
  </div>
</div>