{{!log "eminence" this}}
<section class="eminence-main standard-form">

  <div class="col-1">
    <!-- Personnage -->
    {{> "systems/penombre/templates/eminence/partials/personnage.hbs" }}

    <!-- Harmoniques -->
    {{> "systems/penombre/templates/eminence/partials/harmoniques.hbs" }}

    <!-- Conscience -->
    {{> "systems/penombre/templates/eminence/partials/conscience.hbs" }}
  </div>

  <!-- Filet vertical entre les deux colonnes, comme sur la fiche du livre -->
  <div class="col-2"></div>

  <div class="col-3">
    <!-- Timbre -->
    {{> "systems/penombre/templates/eminence/partials/timbre.hbs" }}

    <!-- Pouvoirs -->
    {{> "systems/penombre/templates/eminence/partials/pouvoirs.hbs" }}

    <!-- Atouts -->
    {{> "systems/penombre/templates/eminence/partials/atouts.hbs" }}

    <!-- Maitrises magiques -->
    {{> "systems/penombre/templates/eminence/partials/maitrises.hbs" }}

    {{#if afficherRecapitulatif}}
      <!-- Récapitulatif : affiché selon l'option de chaque joueur -->
      {{> "systems/penombre/templates/eminence/partials/recapitulatif.hbs" }}
    {{/if}}
  </div>
  
</section>